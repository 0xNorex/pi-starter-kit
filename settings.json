{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "catppuccin",
  "defaultThinkingLevel": "medium",
  "defaultProvider": "custom-provider",
  "defaultModel": "gemini-3.8-flash",
  "enabledModels": [
    "custom-provider/gemini-4-argon",
    "custom-provider/gemini-3.8-flash",
    "custom-provider/deepseek-v4.1-flash",
    "custom-provider/gpt-6.1-sol",
    "custom-provider/gpt-6.1-terra"
  ],
  "packages": [
    "npm:billion-context@0.1.208",
    "npm:pi-cache-optimizer@2.10.4",
    "npm:pi-ask-user@0.17.0",
    "npm:pi-goal-x@0.34.0",
    "npm:@pi-agents/loop@0.3.1",
    "npm:@ff-labs/pi-fff",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "quietStartup": true,
  "defaultTools": [
    "+codemode",
    "+grep",
    "+find",
    "+ls"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "npmCommand": [
    "npm"
  ],
  "hideThinkingBlock": false,
  "defaultProjectTrust": "ask",
  "editorPaddingX": 0,
  "codemode": {
    "mode": "only"
  },
  "cacheWarming": "streaming"
}
