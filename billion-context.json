{
  "autoUpdate": false,
  "network": {
    "upstreamTimeoutMs": 1200000,
    "upstreamFirstByteMs": 1200000
  },
  "providers": {},
  "compress": {
    "promptPack": "lean",
    "nudgeGrowthTokens": 300000,
    "maxContextLimit": "80%",
    "externalSummary": {
      "enabled": true,
      "targets": [
        "magpie/deepseek-v4.1-flash"
      ],
      "autoFold": false
    }
  },
  "pi": {
    "subagents": {
      "forceEnable": true,
      "thinkingLevel": "high",
      "maxDepth": 1,
      "maxConcurrent": 4,
      "agents": {
        "reviewer": {
          "model": "magpie/gpt-6.1-sol",
          "thinkingLevel": "medium"
        },
        "planner": {
          "model": "magpie/gpt-6.1-terra",
          "thinkingLevel": "high"
        },
        "researcher": {
          "model": "magpie/deepseek-v4.1-flash",
          "thinkingLevel": "high"
        },
        "worker": {
          "model": "magpie/deepseek-v4.1-flash",
          "thinkingLevel": "high"
        },
        "oracle": {
          "model": "magpie/gpt-6.1-sol",
          "thinkingLevel": "medium"
        }
      }
    }
  }
}
